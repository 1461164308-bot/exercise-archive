  "u7_math_probability.jpg": [
    {
      "no": 1,
      "type": "解答题",
      "score": 10,
      "stem": "设 P(A) = 0.5，P(B) = 0.4，P(AB) = 0.2，求 P(A|B)。",
      "options": [],
      "student_answer": "P(A|B) = P(AB)/P(B) = 0.2/0.4 = 0.5。",
      "student_steps": [
        "解：由条件概率公式，",
        "P(A|B) = P(AB)/P(B) = 0.2/0.4 = 0.5。"
      ],
      "status": "correct",
      "correct_answer": "0.5",
      "error_type": "",
      "knowledge_points": [
        "条件概率"
      ]
    },
    {
      "no": 2,
      "type": "解答题",
      "score": 10,
      "stem": "甲线产量占 60%，次品率 2%；乙线产量占 40%，次品率 5%。随机取一件发现是次品，求它来自甲线的概率。",
      "options": [],
      "student_answer": "= (0.6×0.02)/0.02 = 0.6。",
      "student_steps": [
        "解：设 A = 来自甲线，B = 取到次品。",
        "P(A|B) = P(A)P(B|A) / P(B|A)",
        "= (0.6×0.02)/0.02 = 0.6。"
      ],
      "status": "wrong",
      "correct_answer": "0.375",
      "error_type": "公式记错",
      "knowledge_points": [
        "贝叶斯公式",
        "全概率公式"
      ]
    }
  ],
