  "u4_math_series_solution.jpg": [
    {
      "no": 1,
      "type": "解答题",
      "score": 10,
      "stem": "判别级数 ∑_{n=1}^{∞} n/2^n 的收敛性。",
      "options": [],
      "student_answer": "故级数收敛。",
      "student_steps": [
        "解：用比值判别法。",
        "lim |a_{n+1}/a_n| = lim ((n+1)/2^(n+1))·(2^n/n)",
        "= lim (n+1)/(2n) = 1/2 < 1，",
        "故级数收敛。"
      ],
      "status": "correct",
      "correct_answer": "收敛（比值判别法，极限为 1/2）",
      "error_type": "",
      "knowledge_points": [
        "正项级数",
        "比值判别法"
      ]
    },
    {
      "no": 2,
      "type": "解答题",
      "score": 10,
      "stem": "判别级数 ∑_{n=1}^{∞} 1/(2n-1) 的收敛性。",
      "options": [],
      "student_answer": "故由比较判别法，原级数收敛。",
      "student_steps": [
        "解：因为 1/(2n-1) < 1/n，",
        "而 ∑ 1/n 收敛，",
        "故由比较判别法，原级数收敛。"
      ],
      "status": "wrong",
      "correct_answer": "发散（1/(2n-1) ~ 1/(2n)，与调和级数同阶）",
      "error_type": "概念错误",
      "knowledge_points": [
        "正项级数",
        "比较判别法",
        "调和级数"
      ]
    }
  ],
