    {
      "no": 2,
      "type": "解答题",
      "score": 10,
      "stem": "求微分方程 y'' - 3y' + 2y = 0 的通解。",
      "options": [],
      "student_answer": "所以通解 y = C_1·e^x + C_2·e^(2x)。",
      "student_steps": [
        "解：特征方程为 r^2 - 3r + 2 = 0，",
        "解得 r_1 = 1，r_2 = 2，",
        "所以通解 y = C_1·e^x + C_2·e^(2x)。"
      ],
      "status": "correct",
      "correct_answer": "y = C1·e^x + C2·e^(2x)",
      "error_type": "",
      "knowledge_points": [
        "二阶常系数线性微分方程",
        "特征方程"
      ]
    }
